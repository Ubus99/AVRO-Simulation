<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/MainStyle.uss?fileID=7433441132597879392&amp;guid=7bc33ff846e8b9241a0405236116a2bc&amp;type=3#MainStyle"/>
    <Style src="project://database/Assets/Scenes/Simulation/UI/ListItem/ListItem.uss?fileID=7433441132597879392&amp;guid=f8fc6d7cfcd81a2419b95d0830db471d&amp;type=3#ListItem"/>
    <ui:VisualElement name="CarView" style="flex-grow: 1; height: 64px;">
        <ui:VisualElement name="Header" class="toolBar" style="flex-grow: 0; height: 64px;"/>
        <ui:VisualElement name="Body" style="flex-grow: 1; flex-direction: row; align-items: stretch; align-self: auto; justify-content: space-between;">
            <ui:ListView item-template="project://database/Assets/Scenes/Simulation/UI/ListItem/ListItem.uxml?fileID=9197481963319205126&amp;guid=fa649713d186e9d4dba59988616d0ed8&amp;type=3#ListItem" binding-source-selection-mode="Manual" data-source="" data-source-type="Scenes.Simulation.UI.ListItem.ListItemData, Assembly-CSharp" name="car-list" style="width: 25%;"/>
            <ui:VisualElement name="Content" style="flex-grow: 1; align-self: stretch; background-color: rgb(0, 0, 0); aspect-ratio: auto;">
                <ui:Image name="mainImage" source="project://database/Assets/Resources/MissionData/Bengt%20Scenarios/Ingolstadt/Scenarios/W-1_S-1_D-1_F.png?fileID=2800000&amp;guid=11974feba3a64a84eb69fba7ea56e2c3&amp;type=3#W-1_S-1_D-1_F" scale-mode="ScaleToFit" style="aspect-ratio: auto;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; width: 25%;">
                <ui:ListView name="actions-list" style="flex-grow: 1;"/>
                <ui:Button text="Confirm" double-click-selects-word="false" triple-click-selects-line="false" name="confirm-button" style="border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="toolBar" style="flex-grow: 0; height: 64px;"/>
    </ui:VisualElement>
</ui:UXML>
