                <ui:Image name="mainImage" style="flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:ListView name="actions-list" style="width: 25%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" style="flex-grow: 0; height: 64px;"/>
    </ui:VisualElement>
</ui:UXML>
