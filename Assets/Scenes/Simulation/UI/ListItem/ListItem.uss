#list-item {
    flex-direction: column;
    align-items: stretch;
}

#top-section {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

#bottom-section {
    flex-direction: row;
    align-items: flex-start;
}


.item-heading {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.lucide-icon {
    width: 48px;
    height: 48px;
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
}
