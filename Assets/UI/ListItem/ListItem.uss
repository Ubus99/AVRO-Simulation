#list-item {
    flex-direction: column;
    align-items: stretch;
}

#top-section {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

#bottom-section {
    flex-direction: row;
    align-items: flex-start;
}

.item-heading {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.unity-collection-view__item {
    background-color: rgb(255, 255, 255);
}

.unity-collection-view__item:hover {
    background-color: rgb(229, 229, 229);
}

.unity-collection-view__item--selected {
    background-color: rgb(242, 242, 242);
}

.unity-button {
    background-color: var(--bgColor2);
    color: var(--mainTextColor);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.unity-button:hover {
    background-color: var(--bgColor3);
}

.unity-button:active {
    background-color: rgb(178, 178, 178);
}

.unity-button__image {
    margin-left: 8px;
}

.unity-button--with-icon > .unity-image {
    --unity-image-tint-color: var(--mainTextColor);
}

.lucide-wrapper {
    -unity-background-image-tint-color: var(--mainTextColor);
}
